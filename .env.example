# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key from https://aistudio.google.com (free tier, no billing)
GEMINI_API_KEY=your-gemini-api-key

# Model name from Google's Gemini API models page (pick one on the free tier)
GEMINI_MODEL=your-model-name

# Max tokens in the model's reply (e.g. 20 to see finish_reason MAX_TOKENS, 1000 for normal use)
GEMINI_MAX_OUTPUT_TOKENS=1000
